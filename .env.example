# Copy to .env.local and fill in. Keep LF line endings (a CRLF file leaves a
# trailing \r on every value — harmless in headers, but on the model name it
# reaches the request body and Google 400s: "unexpected model name format").

# --- App runtime (default provider: gemma via Google's OpenAI-compat endpoint) ---
AI_API_KEY=your-google-ai-studio-key
# No trailing slash — the openai client appends /chat/completions, and a
# trailing slash yields //chat/completions, which Google 404s.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL_NAME=gemma-4-31b-it

# --- OpenRouter (de-risk second track only; DERISK_PROVIDER=openrouter) ---
# The app itself uses the AI_* vars above; these are for scripts/derisk.
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override if needed

# --- Memory backend ---
ZEP_API_KEY=your-zep-key
