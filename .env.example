# Copy to .env.local and fill in. Keep LF line endings (a CRLF file leaves a
# trailing \r on every value — harmless in headers, but on the model name it
# reaches the request body and Google 400s: "unexpected model name format").

# Which set below the app uses: google (default) | openrouter | explabs. Restart dev server after changing.
AI_PROVIDER=google

# Force the env model (AI_MODEL_NAME, OPENROUTER_MODEL, or EXPLABS_MODEL) to override every agent file.
# Unset or false: precedence is file > defaults.md > env fallback > built-in.
AI_MODEL_OVERRIDE=false

# --- google (default provider: gemma via Google's OpenAI-compat endpoint) ---
AI_API_KEY=your-google-ai-studio-key
# No trailing slash — the openai client appends /chat/completions, and a
# trailing slash yields //chat/completions, which Google 404s.
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
AI_MODEL_NAME=gemma-4-31b-it

# --- openrouter (used when AI_PROVIDER=openrouter; scripts/derisk reads it via DERISK_PROVIDER=openrouter) ---
OPENROUTER_API_KEY=your-openrouter-key
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1   # override if needed

# --- explabs (used when AI_PROVIDER=explabs: Experiential Labs OpenAI-compat endpoint) ---
EXPLABS_API_KEY=your-explabs-key
EXPLABS_MODEL=gpt-6-luna
# EXPLABS_BASE_URL=https://api.experientiallabs.ai/v1 # override if needed

# --- Memory backend ---
ZEP_API_KEY=your-zep-key

# --- Image generation (the `novelai` tool, #148) ---
IMAGE_API_KEY=your-novelai-persistent-api-token
# IMAGE_BASE_URL=https://image.novelai.net   # override if needed
# Used when a tool file sets no config.model: nai-diffusion-4-full | nai-diffusion-4-5-full | nai-diffusion-5-full
IMAGE_MODEL=nai-diffusion-4-5-full
# normal (832x1216 / 1216x832 / 1024x1024) | small (512x768 / 768x512 / 640x640, saves quota)
IMAGE_SIZE=normal
# Appended to every prompt; a plugin launch may override this and the two below.
IMAGE_QUALITY=very aesthetic, masterpiece, no text
IMAGE_NEGATIVE=lowres, bad anatomy, bad hands, text, watermark, blurry
IMAGE_SAMPLER=k_euler_ancestral
IMAGE_NOISE_SCHEDULE=karras
# Above 28 steps (or above 1024x1024 px) costs Anlas even on Opus.
IMAGE_STEPS=28
# Prompt guidance (NovelAI "scale"): higher follows the prompt harder, 0-10.
IMAGE_GUIDANCE=5
# Prompt guidance rescale, 0-1: tames the burnt colours of high guidance.
IMAGE_CFG_RESCALE=0
# Variety+: more varied compositions (true/false). nai-diffusion-5-full has none, so it is ignored there.
IMAGE_VARIETY=false
